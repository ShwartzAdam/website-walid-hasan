# Public site origin, used for canonical URLs, sitemap, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.walidhasan.co.il

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Analytics is disabled when empty.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (content of the google-site-verification meta tag).
GOOGLE_SITE_VERIFICATION=

# Content publishing mode.
#   preview (default): unverified content is shown with a "pending verification" badge.
#   strict: any content not backed by a public source or company confirmation is hidden.
# Production launch MUST use strict (PRD §15, §29).
CONTENT_MODE=preview

# Contact form delivery (optional). When RESEND_API_KEY is set, inquiries are emailed via Resend.
# Otherwise they are forwarded to CONTACT_WEBHOOK_URL as JSON (if set) and logged on the server.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=website@walidhasan.co.il
CONTACT_TO_EMAIL=
CONTACT_WEBHOOK_URL=

# Static export (GitHub Pages) only — set automatically by `npm run build:pages` / the Pages workflow.
# NEXT_PUBLIC_BASE_PATH=/website-walid-hasan
# Form service URL used by the static build's contact form (e.g. https://formspree.io/f/xxxx).
NEXT_PUBLIC_CONTACT_ENDPOINT=
